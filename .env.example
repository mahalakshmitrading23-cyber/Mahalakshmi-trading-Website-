# Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables.

# Where enquiries are delivered
ENQUIRY_TO=mahalaxmitrading0101@gmail.com

# SMTP account used to send the emails.
# For Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mahalaxmitrading0101@gmail.com
SMTP_PASS=

# Sender shown on emails (must be the SMTP account for Gmail)
MAIL_FROM="MAHALAXMI TRADING <mahalaxmitrading0101@gmail.com>"

# Public site URL, used for sitemap and social previews
NEXT_PUBLIC_SITE_URL=https://www.example.com
